# Copie para .env e ajuste. O .env está no .gitignore: NUNCA faça commit dele (o repositório é público).
# Nome da rede Docker do Nginx Proxy Manager (veja com: docker network ls)
NPM_REDE=npm_default

# Onde guardar os dados coletados. Sem definir: volume Docker "<projeto>_dados" (recomendado).
# Para usar uma pasta do servidor, use um caminho ABSOLUTO fora da pasta do projeto, por exemplo:
# DADOS=/opt/apuracao-eleicoes/dados

# ---------------------------------------------------------------- Azure Blob (opcional)
# Preenchidos: os dados vão para o Azure Blob e nada fica no container. Vazios: pasta local, como acima.
# Passo a passo no README, seção "Armazenamento no Azure Blob".
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER_PUBLICO=eleicoes
AZURE_CONTAINER_INTERNO=eleicoes-interno
# service principal (Entra ID) com o papel "Eleicoes Gravador Blob" (ler e gravar, sem apagar) nos dois containers
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# data de validade do segredo (AAAA-MM-DD): o /saude avisa 30 dias antes
AZURE_CLIENT_SECRET_EXPIRA=

# De onde o navegador lê os dados. Vazio = /dados/ deste servidor (que repassa do Blob ou da pasta local).
# Com Cloudflare na frente do Blob (regras):  https://dados.seu-dominio/eleicoes/
# Com o Cloudflare Worker de cloudflare/worker.js: https://dados.seu-dominio/
DADOS_URL_PUBLICA=
